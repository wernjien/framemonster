#!/usr/bin/env python3
"""FrameMonster - extract frames from a video as images using ffmpeg."""

import argparse
import platform
import shutil
import subprocess
import sys
from pathlib import Path


def parse_args():
    p = argparse.ArgumentParser(
        prog="framemonster",
        description="Extract frames from a video and save them as images.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    p.add_argument(
        "video",
        help="Path to an input video file, or a directory containing video files",
    )
    p.add_argument(
        "-o", "--output-dir",
        help="Directory to save extracted frames into. For a single video, "
             "frames go directly into this directory (default: "
             "'<video-name>_frames' next to the video). For a directory of "
             "videos, a subfolder per video is created under this directory "
             "(default: '<video-name>_frames' next to each video).",
    )
    p.add_argument(
        "-r", "--recursive", action="store_true",
        help="When VIDEO is a directory, also search subdirectories",
    )

    rate = p.add_mutually_exclusive_group()
    rate.add_argument(
        "--fps", type=float,
        help="Frames to extract per second, e.g. 4 for 4 frames/sec",
    )
    rate.add_argument(
        "--interval", type=float,
        help="Seconds between extracted frames, e.g. 2 for 1 frame every 2 seconds",
    )

    p.add_argument(
        "--format", choices=["jpg", "png"], default="jpg",
        help="Output image format",
    )
    p.add_argument(
        "--quality", type=int, default=2,
        help="JPEG quality for ffmpeg's -qscale:v (2=best, 31=worst). Ignored for png.",
    )
    p.add_argument(
        "--prefix", default="frame",
        help="Filename prefix for extracted frames",
    )
    p.add_argument(
        "--start-number", type=int, default=1,
        help="Starting number for the frame filename sequence",
    )
    p.add_argument(
        "--scale",
        help="Resize frames, e.g. 1280x720 or 1280x-1 (keep aspect ratio)",
    )
    p.add_argument(
        "--start", help="Start time to begin extracting from, e.g. 00:00:10 or 10"
    )
    p.add_argument(
        "--duration", help="Duration to extract, e.g. 00:00:30 or 30"
    )
    p.add_argument(
        "--overwrite", action="store_true",
        help="Overwrite existing files in the output directory",
    )

    return p.parse_args()


VIDEO_EXTENSIONS = {
    ".mp4", ".mov", ".mkv", ".avi", ".webm", ".m4v",
    ".wmv", ".flv", ".mpg", ".mpeg", ".3gp",
}


def find_videos(directory, recursive):
    globber = directory.rglob if recursive else directory.glob
    videos = sorted(
        f for f in globber("*")
        if f.is_file() and f.suffix.lower() in VIDEO_EXTENSIONS
    )
    return videos


def build_fps_expr(args):
    if args.fps is not None:
        if args.fps <= 0:
            sys.exit("error: --fps must be greater than 0")
        return str(args.fps)
    if args.interval is not None:
        if args.interval <= 0:
            sys.exit("error: --interval must be greater than 0")
        return f"1/{args.interval}"
    # default: 1 frame per second
    return "1"


def extract_frames(video_path, output_dir, args, fps_expr):
    output_dir.mkdir(parents=True, exist_ok=True)

    if any(output_dir.iterdir()) and not args.overwrite:
        print(
            f"skipping {video_path.name}: output directory is not empty: {output_dir}\n"
            f"          pass --overwrite to write into it anyway",
            file=sys.stderr,
        )
        return None

    vf_parts = [f"fps={fps_expr}"]
    if args.scale:
        w, h = args.scale.lower().split("x")
        vf_parts.append(f"scale={w}:{h}")
    vf = ",".join(vf_parts)

    pattern = f"{args.prefix}_%05d.{args.format}"
    out_path = output_dir / pattern

    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y"]
    if args.start:
        cmd += ["-ss", args.start]
    cmd += ["-i", str(video_path)]
    if args.duration:
        cmd += ["-t", args.duration]
    cmd += ["-vf", vf, "-start_number", str(args.start_number)]
    if args.format == "jpg":
        cmd += ["-qscale:v", str(args.quality)]
    cmd += [str(out_path)]

    print(f"Extracting frames from {video_path.name} -> {output_dir} (fps={fps_expr})")
    result = subprocess.run(cmd)
    if result.returncode != 0:
        print(f"error: ffmpeg exited with status {result.returncode} for {video_path.name}",
              file=sys.stderr)
        return None

    frame_count = len(list(output_dir.glob(f"{args.prefix}_*.{args.format}")))
    print(f"Done. {frame_count} frame(s) saved to {output_dir}")
    return frame_count


def ffmpeg_install_hint():
    system = platform.system()
    if system == "Darwin":
        return "Install it with 'brew install ffmpeg' (https://brew.sh), or from https://ffmpeg.org/download.html."
    if system == "Linux":
        return (
            "Install it with your package manager, e.g. 'sudo apt install ffmpeg' "
            "(Debian/Ubuntu), 'sudo dnf install ffmpeg' (Fedora), or "
            "'sudo pacman -S ffmpeg' (Arch), or from https://ffmpeg.org/download.html."
        )
    if system == "Windows":
        return (
            "Install it with 'winget install ffmpeg' or 'choco install ffmpeg', "
            "or download a build from https://ffmpeg.org/download.html and add it to PATH."
        )
    return "Download a build for your platform from https://ffmpeg.org/download.html."


def main():
    args = parse_args()

    if shutil.which("ffmpeg") is None:
        sys.exit(f"error: ffmpeg not found on PATH.\n{ffmpeg_install_hint()}")

    video_arg = Path(args.video).expanduser()
    fps_expr = build_fps_expr(args)

    if video_arg.is_dir():
        videos = find_videos(video_arg, args.recursive)
        if not videos:
            sys.exit(f"error: no video files found under {video_arg}")

        base_output_dir = Path(args.output_dir).expanduser() if args.output_dir else None
        failures = 0
        for video_path in videos:
            output_dir = (base_output_dir / video_path.stem) if base_output_dir else \
                video_path.with_name(f"{video_path.stem}_frames")
            if extract_frames(video_path, output_dir, args, fps_expr) is None:
                failures += 1

        processed = len(videos) - failures
        print(f"\nProcessed {processed}/{len(videos)} video(s)")
        if failures:
            sys.exit(1)
        return

    if not video_arg.is_file():
        sys.exit(f"error: video file or directory not found: {video_arg}")

    output_dir = Path(args.output_dir).expanduser() if args.output_dir else \
        video_arg.with_name(f"{video_arg.stem}_frames")
    if extract_frames(video_arg, output_dir, args, fps_expr) is None:
        sys.exit(1)


if __name__ == "__main__":
    main()
